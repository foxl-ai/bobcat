               "clean": "빌드 산출물 폴더 dist/를 지워줘."},
     "commands": {
       "build": {"command": "npm run build && npx serve dist", "irreversible": false, "plan": "사이트를 빌드하고 로컬 미리보기를 띄우겠습니다."},
       "deploy": {"command": "npm run deploy -- --prod", "irreversible": true, "plan": "사이트를 운영 환경에 공개 배포하겠습니다."},
       "rm_dist": {"command": "rm -rf dist", "irreversible": false, "plan": "빌드 산출물 dist/를 삭제하겠습니다."},
       "status": {"command": "git status --short", "irreversible": false, "plan": "작업 트리 상태를 확인하겠습니다."}},
